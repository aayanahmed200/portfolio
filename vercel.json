{
  "buildCommand": "echo 'Static site'",
  "outputDirectory": ".",
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:path+\\.html",
      "destination": "/:path+.html"
    },
    {
      "source": "/:path+",
      "destination": "/:path+.html"
    }
  ]
}
